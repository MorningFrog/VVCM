{
    "build": {
        "dockerfile": "Dockerfile",
        "args": {
            "PYTHON_VERSION": "3.10"
        }
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "morningfrog.symbol-converter"
            ]
        }
    },
    "remoteUser": "root",
    "initializeCommand": "xhost + && sudo apt install acl && sudo setfacl -d -m g:$(id -g):rwx . && sudo setfacl -m g:$(id -g):rwx .",
    "postCreateCommand": "sh install_requirements.sh",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
    "workspaceFolder": "/workspace"
}